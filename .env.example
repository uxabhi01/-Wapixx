# Google Gemini API Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Auto-Responder Settings
# Modes: "all" (reply to everyone) or "whitelist" (only reply to numbers in contacts.json)
AUTO_REPLY_MODE=all

# Custom Business / Bot Persona (AI Instructions)
# Customize this to change how the bot replies to customers.
BOT_PERSONA="You are a helpful, professional, and friendly AI customer assistant for our business. Answer questions accurately and keep replies concise, natural, and helpful."
